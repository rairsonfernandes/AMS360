# ============================================
# Stage 1: Build - SDK completo do .NET 10
# ============================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["AMS360.csproj", "./"]
RUN dotnet restore "AMS360.csproj"

COPY . .
RUN dotnet publish "AMS360.csproj" -c Release -o /app/publish --no-restore

# ============================================
# Stage 2: Runtime - imagem enxuta
# ============================================
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV ASPNETCORE_URLS=http://0.0.0.0:${PORT:-80}

EXPOSE 80

ENTRYPOINT ["dotnet", "AMS360.dll"]
